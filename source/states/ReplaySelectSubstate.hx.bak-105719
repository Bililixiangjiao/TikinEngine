package states;

import flixel.FlxSprite;
import flixel.FlxSubState;
import flixel.FlxCamera;
import flixel.text.FlxText;
import flixel.util.FlxColor;
import flixel.FlxG;
import backend.Paths;
import backend.Highscore;
import backend.Song;
import ReplayUtil;

class ReplaySelectSubstate extends FlxSubState
{
var songName:String;
var diff:Int;
var files:Array<String> = [];
var texts:Array<FlxText> = [];
var cur:Int = 0;
var rowH:Float = 54;
var visibleRows:Int = 8;
var listTop:Float = 0;
var cam:FlxCamera;

public function new(song:String, d:Int)
{
super();
songName = song;
diff = d;
}

function pickCam():FlxCamera
{
var list:Array<FlxCamera> = FlxG.cameras.list;
var i:Int = list.length - 1;
while (i >= 0)
{
var c:FlxCamera = list[i];
if (c != null && Math.abs(c.zoom - 1) < 0.001) return c;
i--;
}
return FlxG.camera;
}

function addUI(o:FlxSprite):Void
{
o.cameras = [cam];
o.scrollFactor.set(0, 0);
add(o);
}

override function create()
{
super.create();
cam = pickCam();
files = ReplayUtil.list(songName, diff);

var W:Float = cam.width;
var H:Float = cam.height;

var bg:FlxSprite = new FlxSprite(0, 0).makeGraphic(Std.int(W), Std.int(H), FlxColor.BLACK);
bg.alpha = 0.95;
addUI(bg);

var fnt = Paths.font('pixel.otf');

var title:FlxText = new FlxText(0, H * 0.07, W, 'SELECT WARP  (' + files.length + ')');
title.setFormat(fnt, 44, FlxColor.WHITE, 'center');
addUI(title);

var line:FlxSprite = new FlxSprite(W * 0.10, H * 0.19);
line.makeGraphic(Std.int(W * 0.80), 3, FlxColor.WHITE);
addUI(line);

if (files.length == 0)
{
var t:FlxText = new FlxText(0, H * 0.45, W, 'NO WARP SAVED');
t.setFormat(fnt, 36, 0xFF888888, 'center');
addUI(t);
var hint:FlxText = new FlxText(0, H * 0.80, W, '[ESC] BACK');
hint.setFormat(fnt, 26, 0xFF888888, 'center');
addUI(hint);
return;
}

listTop = H * 0.26;
for (i in 0...files.length)
{
var t:FlxText = new FlxText(0, listTop + rowH * i, W, ReplayUtil.displayName(files[i]));
t.setFormat(fnt, 30, 0xFF888888, 'center');
addUI(t);
texts.push(t);
}
refresh();

var hint2:FlxText = new FlxText(0, H * 0.88, W, '[UP/DOWN] SELECT   [ENTER] PLAY   [ESC] BACK');
hint2.setFormat(fnt, 22, 0xFF888888, 'center');
addUI(hint2);
}

function refresh()
{
if (texts.length == 0) return;
for (i in 0...texts.length)
{
if (i == cur)
{
texts[i].color = 0xFFFFFFFF;
texts[i].alpha = 1;
}
else
{
texts[i].color = 0xFF888888;
texts[i].alpha = 0.7;
}
}
var first:Int = 0;
if (texts.length > visibleRows)
first = Std.int(Math.max(0, Math.min(cur - Std.int(visibleRows / 2), texts.length - visibleRows)));
for (i in 0...texts.length)
texts[i].y = listTop + rowH * (i - first);
}

override function update(elapsed:Float)
{
super.update(elapsed);

if (files.length == 0)
{
if (FlxG.keys.justPressed.ESCAPE) close();
return;
}

if (FlxG.keys.justPressed.UP) { cur--; if (cur < 0) cur = files.length - 1; refresh(); }
else if (FlxG.keys.justPressed.DOWN) { cur++; if (cur >= files.length) cur = 0; refresh(); }
else if (FlxG.keys.justPressed.ENTER) startReplay(files[cur]);
else if (FlxG.keys.justPressed.ESCAPE) close();
}

function startReplay(file:String)
{
PlayState.replayFileName = file;
PlayState.replayMode = true;
PlayState.storyDifficulty = diff;
var poop:String = Highscore.formatSong(songName, diff);
PlayState.SONG = Song.loadFromJson(poop, songName);
PlayState.isStoryMode = false;
LoadingState.loadAndSwitchState(new PlayState());
}
}