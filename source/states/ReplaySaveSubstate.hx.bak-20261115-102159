import flixel.FlxSprite;
import flixel.FlxSubState;
import flixel.text.FlxText;
import flixel.util.FlxColor;
import flixel.util.FlxTimer;
import flixel.FlxG;
import backend.Paths;
import backend.CoolUtil;
import backend.Highscore;
import ReplayUtil;

class ReplaySaveSubstate extends FlxSubState
{
public static var decided:Bool = false;

var ps:PlayState;
var acc:Float;
var misses:Int;
var maxCombo:Int;
var score:Int;
var songName:String;
var diff:Int;
var done:Bool = false;

public function new(ps:PlayState, acc:Float, misses:Int, maxCombo:Int, score:Int, songName:String, diff:Int)
{
super();
this.ps = ps;
this.acc = acc;
this.misses = misses;
this.maxCombo = maxCombo;
this.score = score;
this.songName = songName;
this.diff = diff;
}

override function create()
{
super.create();

var bg = new FlxSprite().makeGraphic(FlxG.width, FlxG.height, FlxColor.BLACK);
bg.alpha = 0.86;
add(bg);

var fnt = Paths.font('pixel.otf');

var title = new FlxText(0, 50, FlxG.width, 'SONG CLEARED');
title.setFormat(fnt, 44, FlxColor.WHITE, 'center');
add(title);

var line = new FlxSprite(140, 128).makeGraphic(FlxG.width - 280, 2, FlxColor.WHITE);
add(line);

var left = new FlxText(140, 155, 480, '');
left.setFormat(fnt, 22, FlxColor.WHITE, 'left');
left.lineSpacing = 10;
left.text = 'ACCURACY   ' + CoolUtil.floorDecimal(acc * 100, 2) + '%\n'
+ 'MISSES     ' + misses + '\n'
+ 'MAX COMBO  ' + maxCombo + '\n'
+ 'SCORE      ' + score;
add(left);

var bestScore:Int = 0;
var bestAcc:Float = 0;
try { bestScore = Highscore.getScore(songName, diff); } catch (e:Dynamic) {}
try { bestAcc = Highscore.getRating(songName, diff); } catch (e:Dynamic) {}
var dScore:Int = score - bestScore;
var dAcc:Float = (acc - bestAcc) * 100;

var right = new FlxText(FlxG.width - 560, 155, 420, '');
right.setFormat(fnt, 22, 0xFF9AD0FF, 'right');
right.lineSpacing = 10;
right.text = 'BEST SCORE   ' + bestScore + '\n'
+ 'BEST ACC     ' + CoolUtil.floorDecimal(bestAcc * 100, 2) + '%\n'
+ 'DELTA SCORE  ' + (dScore >= 0 ? '+' : '') + dScore + '\n'
+ 'DELTA ACC    ' + (dAcc >= 0 ? '+' : '') + CoolUtil.floorDecimal(dAcc, 2) + '%';
add(right);

var b1 = new FlxSprite(140, FlxG.height - 140).makeGraphic(300, 80, FlxColor.WHITE);
b1.alpha = 0.12;
add(b1);
var t1 = new FlxText(140, FlxG.height - 116, 300, '[F6]  SAVE');
t1.setFormat(fnt, 26, FlxColor.WHITE, 'center');
add(t1);

var b2 = new FlxSprite(FlxG.width - 440, FlxG.height - 140).makeGraphic(300, 80, FlxColor.WHITE);
b2.alpha = 0.12;
add(b2);
var t2 = new FlxText(FlxG.width - 440, FlxG.height - 116, 300, '[F7]  NO SAVE');
t2.setFormat(fnt, 26, FlxColor.WHITE, 'center');
add(t2);
}

override function update(elapsed:Float)
{
super.update(elapsed);
if (done) return;

if (FlxG.keys.justPressed.F6) { done = true; doSave(); }
else if (FlxG.keys.justPressed.F7) { done = true; doNoSave(); }
}

function doSave()
{
if (ps != null && ps.replayData != null && ps.replayData.length > 0)
ReplayUtil.save(songName, diff, ps.replayData);
decided = true;
close();
new FlxTimer().start(0.1, function(_) ps.endSong());
}

function doNoSave()
{
decided = true;
close();
new FlxTimer().start(0.1, function(_) ps.endSong());
}
}